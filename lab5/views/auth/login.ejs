<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>
    <%- include("../partials/headerNotAuth", {active: "login"}) %>
    
    <% if (errors && errors.length > 0) { %>
        <ul>
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    <% } %>

    
    <form class="form h-100" action="/login" method="POST">
        <h1>Форма аутентификации</h1>

        <div class="form-group">
            <label for="email">Почта:</label>
            <input type="email" name = "email" id = "email" required placeholder="example@gmail.com" minlength="8" maxlength="50">
        </div>

        <div class="form-group">
            <label for="password">Пароль:</label>
            <input type="password" name = "password" id = "password" required placeholder="ваш пароль" minlength="8" maxlength="64">
        </div>

        <button class="button">Войти</button>
    </form>

    <%- include("../partials/footer") %>
</body>
</html>