<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>
    <%- include("./partials/header", {active: "profile"}) %>

    
    <div class="grid w-1/2 gap-8">
        <div class="card">
            <h1 class="text-3xl">Профиль пользователя </h1>
        </div>

        <div class="card w-full">
            <h1 class="text-2xl w-full"> <%= user.username %> </h1>
            <p class="w-full">Email: <%= user.email %></p>
            <p class="w-full">Роль этого пользователя: <%= user.role %></p>

            <p class="w-full">Последний вход: <%= user.lastLogin ? new Date(user.lastLogin).toLocaleString('ru-RU')
            : 'Ещё не входил'  %></p>

            <p class="w-full">
                Дата регистрации:
                <%= new Date(user.createdAt).toLocaleString('ru-RU') %>
            </p>

        </div>
    </div>
    <%- include("./partials/footer")%>
</body>
</html>