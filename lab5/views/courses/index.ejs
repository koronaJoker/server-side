<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses Main Page</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>


    <%- include("../partials/header", {active : "courses"}) %>
   
        <form action="/courses" method="GET" class="w-full flex gap-2 px-16 my-8">
            
            <input
                class="w-full"
                type="text"
                name="search"
                id="search"
                placeholder="🔍 Найти курс"
                value="<%= typeof search !== 'undefined' ? search : '' %>"
            >

            <select name="semester" id="semester">
                <option value="all">Все семестры</option>
                <% for (let i = 1; i <= 8; i++) { %>
                    <option
                        value="<%= i %>"
                        <%= typeof semester !== 'undefined' && String(semester) === String(i) ? 'selected' : '' %>
                    >
                        <%= ['I','II','III','IV','V','VI','VII','VIII'][i - 1] %> семестр
                    </option>
                <% } %>
            </select>

            <select class="text-justify" name="teacherId" id="teacherId">
                <option value="all">Все учителя</option>
                <% teachers.forEach(teacher => { %>
                    <option
                        value="<%= teacher.id %>"
                        <%= String(teacherId || 'all') === String(teacher.id) ? "selected" : '' %>
                    >
                    <%= teacher.name %>
                    </option>
                <% }) %>
            </select>

            <button type="submit" class="accept-btn">
                Применить
            </button>
        </form>


        <div id="notifications" class="w-1/2 mx-auto my-8 py-4">
            <h3 class="font-black text-xl text-center text-gray-800">
                Уведомления
            </h3>

        <div id="notification-list" class="my-6 flex flex-col gap-4">
            <% if (notification) { %>
                <div class="notification flex justify-between items-start bg-white shadow-xl rounded-xl p-5 mb-4 border border-gray-100">
                    <div class="flex flex-col gap-2">
                        <h4 class="font-bold text-gray-800 text-lg">Добавлен новый курс: <%= notification.courseName %></h4>
                        <p class="text-gray-600 text-sm">Преподаватель: <%= notification.teacherName %></p>
                        <small class="text-gray-400"><%= notification.createdAt %></small>
                    </div>
                    <button type="button" class="text-gray-400 hover:text-red-500 text-2xl font-bold ml-4 transition" aria-label="Закрыть уведомление" onclick="this.closest('.notification').remove()">×</button>
                </div>
            <% } else { %>
            <p class="text-center text-gray-400">
                Уведомлений пока нет
            </p>
            <% } %>
        </div>
</div>

    <% if (courses.length > 0) { %>
        <%- include("../partials/coursesTable", {courses}) %>
    
    <% } else { %> 
         <div class="text-center py-12">
        <h2 class="text-xl font-bold text-gray-500">
            Курсы не найдены
        </h2>
        <p class="text-gray-400 mt-2">
            Попробуйте изменить параметры поиска или фильтрации.
        </p>
    </div>
    <%  } %>

    <%- include("../partials/footer") %>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/notifications.js"></script>
</body>
</html>
