

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses Create Form</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>

    <%- include("../partials/header", {active : "courses"}) %>

    <div class="container">

        <% if (errors && errors.length > 0) { %>
            <div class="errors">
                <div>
                    <span>Пожалуйста, исправьте ошибки</span>
                </div>

                <ul>
                    <% errors.forEach(error => { %>
                        <li><%= error %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <h1>Добавить новый курс</h1>

        <form action="/courses" method="POST">
            <div class="card">

                <p>Имя дисциплины:</p>
                <input
                    type="text"
                    name="title"
                    placeholder="Discipline"
                >

                <p>Преподаватель:</p>
                <select name="teacherId" id="teacherId">
                    <option value="" disabled selected>Выберите препода</option>

                    <% teachers.forEach(teacher => { %>
                        <option value="<%= teacher.id %>">
                            <%= teacher.name %>
                        </option>
                    <% })%>
                </select>

                <p>Credits:</p>
                <input
                    type="number"
                    name="credits"
                    placeholder="5"
                >

                <p>Semester:</p>
                <select name="semester" id="semester" class="w-full text-center">
                    <option value="1">I</option>
                    <option value="2">II</option>
                </select>

                <p class="desc">Description:</p>
                <textarea
                    name="description"
                    placeholder="blablabla..."
                ></textarea>

            </div>

            <button type="submit" class="add-btn w-full mt-4">
                Добавить
            </button>
        </form>

    </div>

    <%- include("../partials/footer") %>

</body>
</html>
