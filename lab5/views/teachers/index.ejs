<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses Main Page</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>

    <%- include("../partials/header", {active : "teachers"}) %>
   

        <div id="notifications" class="w-1/2 mx-auto my-8 py-4">
            <h3 class="font-black text-xl text-center text-gray-800">
                Уведомления
            </h3>

            <div id="notification-list" class="my-6 flex flex-col gap-4">
                <p class="text-center text-gray-400">
                    Уведомлений пока нет
                </p>
            </div>
        </div>


        <% if (error === "has-courses") { %>
        <div class="bg-red-100 text-red-700 p-4 rounded-lg mb-4">
            Нельзя удалить преподавателя, у которого есть курсы!
        </div>
    <% } %>

        <% if (teachers.length > 0) { %>
        <%- include("../partials/teachersTable", {teachers}) %>
    
    <% } else { %> 
         <div class="text-center py-12">
        <h2 class="text-xl font-bold text-gray-500">
            Преподаватели не найдены
        </h2>
        <p class="text-gray-400 mt-2">
            возможно произошла ошибка
        </p>
    </div>
    <%  } %>


    
    <%- include("../partials/footer") %>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/notifications.js"></script>
</body>
</html>