    <table>
    <caption>Все преподаватели</caption>

    <thead>
        <tr>
            <th>Имя</th>
            <th>Почта</th>
            <th>Департамент</th>
            <th>Ученая степень</th>
            <th colspan="2">Действия</th>
        </tr>
    </thead>

    <tbody>
        <% teachers.forEach(teacher => { %>
                <tr onclick="window.location.href='/teachers/<%= teacher.id %>'">
                    <td><%= teacher.name %></td>
                    <td><%= teacher.email %></td>
                    <td><%= teacher.department %></td>
                    <td><%= teacher.academicDegree %></td>
                    
                    <td class = "edit">
                        <a href="/teachers/<%= teacher.id %>/edit">
                            <button>Изменить</button>
                        </a>
                    </td>
                    <td>
                        
                    <button onclick = "deleteCourse(event, <%= teacher.id %>)" type="submit" class="delete-btn">Удалить</button>

                    </td>
                </tr>
        <% }) %>
    </tbody>
</table>

<script>
    async function deleteTeacher(event, id) {
        event.stopPropagation()
        const ans = confirm ("Хотите удалить курс?")
        if (!ans) {
            return
        }
        
        const response= await fetch(`/teachers/${id}`, {
            method: "DELETE"
        })
        if (response.ok) {
            window.location.href = '/teachers'
        }
        else {
            alert("Не удалось удалить преподавателя")
        }
    }
</script>