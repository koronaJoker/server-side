
<header class="flex items-center justify-between px-8 py-4 flex-wrap gap-4">

    <!-- Логотип -->
    <h1
        onclick="window.location.href='/courses'"
        class="text-2xl font-bold cursor-pointer hover:text-rose-500 transition"
    >
        USM.md
    </h1>

    <!-- Навигация -->
    <nav class="flex items-center gap-4">
        <a
            href="/courses"
            class="<%= active === 'courses' ? 'active' : '' %>"
        >
            Курсы
        </a>

        <a
            href="/teachers"
            class="<%= active === 'teachers' ? 'active' : '' %>"
        >
            Преподы
        </a>

         <a
            href="/statistics"
            class="<%= active === 'statistics' ? 'active' : '' %> "
        >
            Статистика
        </a>
    </nav>

    <!-- Поиск и фильтры -->
    <% if (active === 'courses') { %>
        <form action="/courses" method="GET" class="flex items-center gap-2">
            <input
                type="text"
                name="search"
                id="search"
                placeholder="🔍 Найти курс"
                value="<%= typeof search !== 'undefined' ? search : '' %>"
            >

            <select name="semester" id="semester">
                <option value="all">Все семестры</option>
                <% for (let i = 1; i <= 8; i++) { %>
                    <option
                        value="<%= i %>"
                        <%= typeof semester !== 'undefined' && String(semester) === String(i) ? 'selected' : '' %>
                    >
                        <%= ['I','II','III','IV','V','VI','VII','VIII'][i - 1] %> семестр
                    </option>
                <% } %>
            </select>

            <select class="text-justify" name="teacherId" id="teacherId">
                <option value="all">Все учителя</option>
                <% teachers.forEach(teacher => { %>
                    <option
                        value="<%= teacher.id %>"
                        <%= String(teacherId || 'all') === String(teacher.id) ? "selected" : '' %>
                    >
                    <%= teacher.name %>
                    </option>
                <% }) %>
            </select>

            <button type="submit" class="accept-btn">
                Применить
            </button>
        </form>
    <% } %>

    <!-- Добавление -->

    <div class="flex items-center gap-3">
        <a href="/courses/new" class="add-btn">
            Добавить курс
        </a>

        <a href="/teachers/new" class="add-btn">
            Добавить учителя
        </a>
    </div>
    
</header>
