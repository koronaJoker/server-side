<header class="bg-gray-50 grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center w-full min-h-24 px-6 lg:px-16 py-4 gap-4 mb-0">

    <!-- Логотип -->
    <a
        href="/courses"
        class="logo"
    >
        USM.md
    </a>

    <!-- Навигация -->
    <nav class="flex flex-wrap items-center justify-center gap-4 justify-self-center">
        
        <a
            href="/courses"
            class="whitespace-nowrap <%= active === 'courses' ? 'active' : '' %>"
        >
            Курсы
        </a>

        <a
            href="/teachers"
            class="whitespace-nowrap <%= active === 'teachers' ? 'active' : '' %>"
        >
            Преподы
        </a>
        <% if (user?.role) { %>
        <a
            href="/statistics"
            class="whitespace-nowrap <%= active === 'statistics' ? 'active' : '' %>"
        >
            Статистика
        </a>
         
        <a
            href="/profile"
            class="whitespace-nowrap <%= active === 'profile' ? 'active' : '' %>"
        >
            Профиль
        </a>
        <% } %>
    </nav>




    <!-- Действия -->
    <div class="flex flex-wrap items-center justify-center md:justify-end gap-3 justify-self-center md:justify-self-end">
        <% if (user?.role === 'admin') { %>
            <a href="/courses/new" class="add-btn whitespace-nowrap">
                Добавить курс
            </a>

            <a href="/teachers/new" class="add-btn whitespace-nowrap">
                Добавить учителя
            </a>
        <% } %>

        <% if (user?.role) { %>
        <form action="/logout" method="POST">
            <button
                type="submit"
                class="logout bg-rose-500 whitespace-nowrap <%= active === 'profile' ? 'active' : '' %>"
            >
                Выйти
            </button>
        </form>
        <% } else { %>
            <a href="/register" class="add-btn">Регистрация</a>
            <a href="/login" class="logout">Войти</a>
        <% }%>
    </div>


</header>   