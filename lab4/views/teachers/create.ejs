
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Добавить преподавателя</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body>

    <%- include("../partials/header", {active : "teachers"}) %>

    <div class="container">

        <% if (errors && errors.length > 0) { %>
            <div class="errors">
                <div>
                    <span>Пожалуйста, исправьте ошибки</span>
                </div>

                <ul>
                    <% errors.forEach(error => { %>
                        <li><%= error %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <h1>Добавить преподавателя</h1>

        <form action="/teachers" method="POST">

            <div class="card">

                <p>Имя:</p>
                <input
                    type="text"
                    name="name"
                    placeholder="John Snow"
                    required
                >

                <p>Email:</p>
                <input
                    type="email"
                    name="email"
                    placeholder="example@mail.com"
                    required
                >

                <p>Департамент: </p>
                <input type="text" name = "department" placeholder="Mathematics" minlength="3" maxlength="50" required>

                <p>Учёная степень: </p>
                <input type="text" name="academicDegree" placeholder="Professor" minlength="3" maxlength="50">
            </div>

            <button type="submit" class="add-btn w-full mt-4">
                Добавить
            </button>

        </form>

    </div>

    <%- include("../partials/footer") %>

</body>
</html>
