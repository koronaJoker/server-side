<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../public/css/output.css">
</head>
<body>
    <% include("partials/header") %>

    <form action="/courses">
        <h1>Форма регистрации</h1>

        <div class="form-group">
            <label for="username">Ваше имя:</label>
            <input type="text" name = "username" id = "username" placeholder="Ivan Ivanov" minlength="3" maxlength="50">
        </div>

        <div class="form-group">
            <label for="email">Почта:</label>
            <input type="email" name = "email" id = "email" placeholder="example@gmail.com" minlength="8" maxlength="50">
        </div>

        <div class="form-group">
            <label for="password">Пароль:</label>
            <input type="password" name = "password" id = "password" placeholder="ваш пароль" minlength="8" maxlength="64">
        </div>

         <div class="form-group">
            <label for="confirm-password">Подтвердите пароль:</label>
            <input type="confirm-password" name = "confirm-password" id = "confirm-password" placeholder="Введите пароль еще раз" minlength="8" maxlength="64">
        </div>

        <button class="button">Регистрация</button>
    </form>

    
</body>
</html>