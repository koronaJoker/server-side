    <table>
    <caption>Все курсы</caption>

    <thead>
        <tr>
            <th>Название</th>
            <th>Преподаватель</th>
            <th>Credits</th>
            <th>Semester</th>
            <th>Описание</th>
            <th colspan="2">Действия</th>
        </tr>
    </thead>

    <tbody>
        <% courses.forEach(course => { %>
                <tr onclick="window.location.href='/courses/<%= course.id %>'">
                    <td><%= course.title %></td>
                    <td><%= course.Teacher?.name ?? "Не назначен" %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.semester %></td>
                    <td class="desc"><%= course.description %></td>
                    
                    <td class = "edit">
                        <a href="/courses/<%= course.id %>/edit">
                            <button>Изменить</button>
                        </a>
                    </td>
                    <td>
                    <form action = "/courses/<%= course.id %>/delete" method = "POST"
                        onclick="event.stopPropagation()"
                        onsubmit="return confirm('Хотите удалить курс?')">
                        <button type = "submit" class="delete-btn">Удалить</button>
                    </form>
                    </td>
                </tr>
        <% }) %>
    </tbody>
</table>

