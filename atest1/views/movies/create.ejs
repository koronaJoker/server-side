<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">

    <title>Добавить фильм</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include("../partials/nav") %>

<div class="form-container">

    <h1>Добавить фильм</h1>

    <form action="/api/movies" method="POST">

        <label>
            Название

            <input
                type="text"
                name="title"
                required
            >
        </label>

        <label>
            Жанр

            <input
                type="text"
                name="genre"
                required
            >
        </label>

        <label>
            Год

            <input
                type="number"
                name="year"
                required
            >
        </label>

        <label>
            Режиссер

            <input
                type="text"
                name="director"
                required
            >
        </label>

        <button type="submit">
            Добавить
        </button>

    </form>

    <a href="/movies">
        ← Назад
    </a>

</div>

</body>
</html>