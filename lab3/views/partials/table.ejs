    <table>
    <caption>Все курсы</caption>

    <thead>
        <tr>
            <th>Название</th>
            <th>Преподаватель</th>
            <th>Credits</th>
            <th>Semester</th>
            <th>Описание</th>
            <th colspan="2">Действия</th>
        </tr>
    </thead>

    <tbody>
        <% courses.forEach(course => { %>
                <tr onclick="window.location.href='/courses/<%= course.id %>'">
                    <td><%= course.title %></td>
                    <td><%= course.teacher %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.semester %></td>
                    <td class="desc"><%= course.description %></td>
                    
                    <td class = "edit">
                        <a href="/courses/<%= course.id %>/edit">
                            <button>Изменить</button>
                        </a>
                    </td>
                    <td>
                        
                    <button onclick = "deleteCourse(event, <%= course.id %>)" type="submit" class="delete-btn">Удалить</button>

                    </td>
                </tr>
        <% }) %>
    </tbody>
</table>

<script>
    async function deleteCourse(event, id) {
        event.stopPropagation()
        const ans = confirm ("Хотите удалить курс?")
        if (!ans) {
            return
        }
        
        const response= await fetch(`/courses/${id}`, {
            method: "DELETE"
        })
        if (response.ok) {
            window.location.href = '/courses'
        }
        else {
            alert("Не удалось удалить курс")
        }
    }
</script>